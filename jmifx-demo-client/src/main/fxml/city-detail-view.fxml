<?xml version="1.0" encoding="UTF-8"?>

<!-- Jmix-detail-view-style editor: one field, Save persists via REST -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jmifx.demo.client.CityDetailViewController"
      spacing="10" alignment="CENTER" prefWidth="400" prefHeight="220">
    <Label fx:id="titleLabel" text="City name"/>
    <TextField fx:id="cityField" promptText="Enter city name"/>
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="saveButton" text="Save" onAction="#save"/>
        <Button fx:id="backButton" text="Back" onAction="#back"/>
    </HBox>
    <Label fx:id="statusLabel" text=""/>
</VBox>
