<?xml version="1.0" encoding="UTF-8"?>

<!-- Jmix-login-style view: the app's startup view (DemoFxApp) -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jmifx.demo.client.LoginViewController"
      spacing="10" alignment="CENTER" prefWidth="400" prefHeight="220">
    <Label fx:id="titleLabel" text="Login"/>
    <TextField fx:id="usernameField" promptText="Username"/>
    <PasswordField fx:id="passwordField" promptText="Password"/>
    <Button fx:id="loginButton" text="Sign in" onAction="#login"/>
    <Label fx:id="statusLabel" text=""/>
</VBox>
